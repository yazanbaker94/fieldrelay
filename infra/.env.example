# Copy to infra/.env. This file contains placeholders only; never commit infra/.env.
FIELDRELAY_DOMAIN=fieldrelay.swoop.video
# A shared host Caddy service keeps 80/443. FieldRelay's internal gateway is
# published only on this loopback port.
FIELDRELAY_ORIGIN_PORT=18042

# Optional absolute path to environment values required only while validating
# the host's complete Caddy configuration. Keep the actual path host-local.
FIELDRELAY_HOST_CADDY_ENV_FILE=

# Local default: the project root. The VPS release workflow sets these to the
# stable /opt/fieldrelay shared-data boundary.
FIELDRELAY_DEPLOY_ROOT=
FIELDRELAY_BACKUP_DIR=

# Published GHCR images may replace these local defaults during a release.
FIELDRELAY_WEB_IMAGE=fieldrelay-web:local
FIELDRELAY_API_IMAGE=fieldrelay-api:local

POSTGRES_DB=fieldrelay
POSTGRES_USER=fieldrelay
# Use a long URL-safe value and repeat its URL-encoded form in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-value
DATABASE_URL=postgresql://fieldrelay:replace-with-a-long-random-url-safe-value@db:5432/fieldrelay

LOG_LEVEL=info
CORS_ORIGIN=https://fieldrelay.swoop.video
ALLOW_CANONICAL_MUTATIONS=false
PUBLIC_WRITE_LIMIT_PER_HOUR=120
MAX_DEMO_RUNS=500
MAX_SSE_CONNECTIONS_PER_CLIENT=3
MAX_SSE_CONNECTIONS_GLOBAL=100

# The local simulator performs no external delivery.
DELIVERY_DESTINATION_TYPE=GENERIC_WEBHOOK
DELIVERY_DESTINATION_NAME=ERP Demo / Generic Webhook
DELIVERY_DESTINATION_URL=local://delivery-simulator

# Backups remain inside FIELDRELAY_DEPLOY_ROOT.
BACKUP_RETENTION_DAYS=14

# AWS is intentionally not configured. Add a future adapter only after credentials
# and a concrete integration contract are available.
