# FIELDRELAY_HOST_SITE_V1
# Managed only by FieldRelay's deployment script. Every unrelated host remains in
# its existing Caddy file.
fieldrelay.swoop.video {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	@events path /api/v1/events
	reverse_proxy @events 127.0.0.1:18042 {
		flush_interval -1
	}

	reverse_proxy 127.0.0.1:18042 {
		health_uri /healthz
		health_interval 20s
		health_timeout 5s
	}
}
