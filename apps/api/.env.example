# Leave DATABASE_URL empty to run the complete demo with the in-memory store.
DATABASE_URL=
PORT=4100
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# The default local simulator never makes an external request.
DELIVERY_DESTINATION_TYPE=GENERIC_WEBHOOK
DELIVERY_DESTINATION_NAME=ERP Demo / Generic Webhook
DELIVERY_DESTINATION_URL=local://delivery-simulator

# OData is an illustrative enterprise adapter only. It does not imply WiQ uses SAP/OData.
# DELIVERY_DESTINATION_TYPE=ODATA_EXAMPLE
# DELIVERY_DESTINATION_NAME=ERP Demo / OData Example Adapter
# DELIVERY_DESTINATION_URL=https://example.invalid/odata/Shipments
